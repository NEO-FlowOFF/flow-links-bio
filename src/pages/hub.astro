---
import "../styles/global.css";
import HubHeader from "../components/HubHeader.astro";
import LinkCard from "../components/LinkCard.astro";
import { sections } from "../data/links";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>NEØ FlowOFF | Agency Hub · Web3 + AI</title>
    <meta name="description" content="NEØ FlowOFF: Sua infraestrutura completa de Web3 e IA na Base Mainnet." />
    <meta name="keywords" content="NEO FlowOFF, Web3, Blockchain, AI, Base Mainnet, Crypto, Agency Hub" />
    <meta name="author" content="NEØ FlowOFF Agency" />
    <link rel="canonical" href="https://flow-links-bio.pages.dev/hub" />
    <meta name="robots" content="index, follow" />

    <!-- Theme / PWA -->
    <meta name="theme-color" content="#FF00CC" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="NEØ Hub" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="NEØ FlowOFF Agency" />
    <meta property="og:title" content="NEØ FlowOFF — O Hub da Nova Economia" />
    <meta property="og:description" content="Acelere seus projetos com nossa infraestrutura Web3 + AI." />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:url" content="https://flow-links-bio.pages.dev/hub" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@neoflowoff" />
    <meta name="twitter:title" content="NEØ FlowOFF — Agency Hub" />
    <meta name="twitter:description" content="Infraestrutura Web3 + IA para todos." />
    <meta name="twitter:image" content="/og-image.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;0,900;1,900&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="mesh"></div>
    <div class="grain"></div>

    <div class="page">
      <HubHeader />

      {sections.map((section) => (
        <section class="section">
          <div class="section-label">{section.label}</div>
          <div class="link-grid">
            {section.links.map((link) => (
              <LinkCard
                href={link.href}
                title={link.title}
                sub={link.sub}
                icon={link.icon}
                color={link.color}
                badges={link.badges}
              />
            ))}
          </div>
        </section>
      ))}

      <footer class="hub-footer">
        <div class="hub-footer-brand">
          <span class="neo">NEØ</span> FlowOFF
        </div>
        <div class="hub-footer-sub">On Chain · Base Mainnet</div>
      </footer>
    </div>

    <script>
      document.querySelectorAll<HTMLElement>(".lc:not(.lc-soon)").forEach((el) => {
        el.addEventListener("pointerdown", (e: PointerEvent) => {
          const target = e.currentTarget as HTMLElement;
          const r = document.createElement("span");
          const rect = target.getBoundingClientRect();
          const size = Math.max(rect.width, rect.height) * 2;
          r.style.cssText = `
            position:absolute;width:${size}px;height:${size}px;
            left:${e.clientX - rect.left - size / 2}px;top:${e.clientY - rect.top - size / 2}px;
            border-radius:50%;background:rgba(255,255,255,0.06);
            transform:scale(0);animation:ripple .45s ease forwards;pointer-events:none;
          `;
          target.appendChild(r);
          setTimeout(() => r.remove(), 500);
        });
      });
    </script>
  </body>
</html>

<style>
  /* ── MESH BACKGROUND ── */
  .mesh {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 60% 50% at 12% 8%, rgba(255, 0, 204, 0.1) 0%, transparent 55%),
      radial-gradient(ellipse 45% 40% at 88% 80%, rgba(0, 242, 255, 0.08) 0%, transparent 50%);
  }

  .grain {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.3;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
  }

  /* ── LAYOUT ── */
  .page {
    position: relative;
    z-index: 1;
    max-width: 480px;
    margin: 0 auto;
    padding: 3rem 1rem 4rem;
  }

  /* ── SECTIONS ── */
  .section {
    margin-bottom: 2rem;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 0.75rem;
    padding: 0 0.15rem;
  }

  .section-label::before,
  .section-label::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  /* ── GRID — ALWAYS 2 COLS ── */
  .link-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  /* ── iOS CARD ── */
  .lc {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 0.95rem;
    border-radius: 16px;
    background: var(--glass);
    border: 1px solid var(--border);
    backdrop-filter: blur(40px) saturate(180%);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    text-decoration: none;
    color: var(--text);
    position: relative;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  /* acqua reveal on left edge */
  .lc::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at -15% 50%, var(--acqua-dim) 0%, transparent 55%),
      radial-gradient(circle at 115% 50%, rgba(216, 230, 29, 0.06) 0%, transparent 55%);
    pointer-events: none;
  }

  /* top shine line */
  .lc::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 242, 255, 0.3), rgba(255, 255, 255, 0.15), rgba(216, 230, 29, 0.3), transparent);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .lc:hover {
    background: var(--glass-h);
    border-color: var(--border-h);
    transform: translateY(-3px);
    box-shadow:
      0 6px 24px rgba(0, 242, 255, 0.1),
      0 0 0 1px rgba(0, 242, 255, 0.06);
  }

  .lc:hover::after { opacity: 1; }
  .lc:active { transform: scale(0.97); }

  /* ── SOON ── */
  .lc.lc-soon {
    opacity: 0.32;
    filter: grayscale(100%);
    pointer-events: none;
  }

  .lc.lc-soon::before,
  .lc.lc-soon::after { display: none; }

  /* ── ICON ── */
  .lc-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1.2rem;
  }

  .lc-icon.pink {
    background: var(--pink-dim);
    border: 1px solid rgba(255, 0, 204, 0.2);
    color: var(--pink);
  }

  .lc-icon.neon {
    background: var(--neon-dim);
    border: 1px solid var(--neon-glow);
    color: var(--neon);
  }

  .lc-icon.acqua {
    background: var(--acqua-dim);
    border: 1px solid rgba(0, 242, 255, 0.2);
    color: var(--acqua);
  }

  .lc-icon.amber {
    background: var(--amber-dim);
    border: 1px solid rgba(255, 170, 0, 0.2);
    color: var(--amber);
  }

  .lc-icon.mono {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    color: var(--text-3);
  }

  /* ── TEXT ── */
  .lc-body { flex: 1; min-width: 0; }

  .lc-title {
    font-weight: 700;
    font-size: 0.85rem;
    color: #fff;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lc-sub {
    font-family: var(--mono);
    font-size: 0.55rem;
    color: var(--text-3);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── BADGES ── */
  .lc-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 0.4rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.12rem 0.45rem;
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 0.48rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    color: var(--text-3);
  }

  .badge.neon {
    border-color: rgba(216, 230, 29, 0.25);
    color: var(--neon);
    background: rgba(216, 230, 29, 0.06);
  }

  .badge.acqua {
    border-color: rgba(0, 242, 255, 0.25);
    color: var(--acqua);
    background: rgba(0, 242, 255, 0.06);
  }

  .badge.pink {
    border-color: var(--pink-glow);
    color: var(--pink-s);
    background: var(--pink-dim);
  }

  .badge.mono {
    border-color: var(--border);
    color: var(--text-3);
  }

  .badge.live::before {
    content: "";
    width: 4px;
    height: 4px;
    background: currentColor;
    border-radius: 50%;
    animation: blink 2s ease infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  /* ── FOOTER ── */
  .hub-footer {
    text-align: center;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    animation: fadeUp 0.5s ease both 0.7s;
  }

  .hub-footer-brand {
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: -0.02em;
    color: var(--text-3);
  }

  .hub-footer-brand .neo {
    color: var(--pink);
    opacity: 0.6;
  }

  .hub-footer-sub {
    font-family: var(--mono);
    font-size: 0.55rem;
    color: var(--text-3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .section:nth-child(1) { animation: fadeUp 0.45s ease both 0.3s; }
  .section:nth-child(2) { animation: fadeUp 0.45s ease both 0.4s; }
  .section:nth-child(3) { animation: fadeUp 0.45s ease both 0.5s; }
  .section:nth-child(4) { animation: fadeUp 0.45s ease both 0.6s; }

  @keyframes ripple {
    to { transform: scale(1); opacity: 0; }
  }

  /* ── MOBILE ── */
  @media (max-width: 400px) {
    .page { padding: 2rem 0.75rem 3rem; }
    .lc { padding: 0.75rem 0.85rem; gap: 0.6rem; }
    .lc-icon { width: 36px; height: 36px; border-radius: 10px; font-size: 1rem; }
    .lc-title { font-size: 0.8rem; }
  }
</style>
