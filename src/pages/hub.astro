---
import HubHeader from "../components/HubHeader.astro";
import LinkCard from "../components/LinkCard.astro";
import { sections } from "../data/links";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>NEØ FlowOFF | Agency Hub · Web3 + AI</title>
    <meta
      name="description"
      content="NEØ FlowOFF: Sua infraestrutura completa de Web3 e IA na Base Mainnet. Hub central para tokens, pagamentos, treinamento em IA e ferramentas de automação."
    />
    <meta
      name="keywords"
      content="NEO FlowOFF, Web3, Blockchain, AI, Inteligência Artificial, Base Mainnet, Crypto, Agency Hub, Pagamentos Web3, Tokens"
    />
    <meta name="author" content="NEØ FlowOFF Agency" />
    <link rel="canonical" href="https://flow-links-bio.pages.dev/hub" />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />

    <!-- Theme / PWA -->
    <meta name="theme-color" content="#FF00CC" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="NEØ Hub" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / SEO -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="NEØ FlowOFF Agency" />
    <meta property="og:title" content="NEØ FlowOFF — O Hub da Nova Economia" />
    <meta
      property="og:description"
      content="Acelere seus projetos com nossa infraestrutura Web3 + AI. Tudo em um lugar na Base Mainnet."
    />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:url" content="https://flow-links-bio.pages.dev/hub" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@neoflowoff" />
    <meta name="twitter:creator" content="@neoflowoff" />
    <meta name="twitter:title" content="NEØ FlowOFF — Agency Hub" />
    <meta
      name="twitter:description"
      content="Infraestrutura Web3 + IA para todos. Pagamentos e ferramentas On-Chain."
    />
    <meta name="twitter:image" content="/og-image.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;0,900;1,900&family=DM+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #06060a;
        --surface: #0c0c12;
        --glass: rgba(255, 255, 255, 0.052);
        --glass-h: rgba(255, 255, 255, 0.09);
        --glass-str: rgba(255, 255, 255, 0.12);
        --border: rgba(255, 255, 255, 0.08);
        --border-h: rgba(255, 255, 255, 0.18);
        --pink: #ff00cc;
        --pink-s: #ff40d9;
        --pink-dim: rgba(255, 0, 204, 0.16);
        --pink-glow: rgba(255, 0, 204, 0.28);
        --neon: #d8e61d;
        --neon-dim: rgba(216, 230, 29, 0.14);
        --neon-glow: rgba(216, 230, 29, 0.25);
        --acqua: #00ffaa;
        --acqua-dim: rgba(0, 255, 170, 0.14);
        --acqua-glow: rgba(0, 255, 170, 0.4);
        --amber: #ffaa00;
        --amber-dim: rgba(255, 170, 0, 0.14);
        --blue: #0aa;
        --blue-dim: rgba(0, 170, 200, 0.14);
        --purple: #9955ff;
        --purple-dim: rgba(153, 85, 255, 0.14);
        --text: rgba(255, 255, 255, 0.9);
        --text-2: rgba(255, 255, 255, 0.52);
        --text-3: rgba(255, 255, 255, 0.28);
        --r-sm: 12px;
        --r-md: 18px;
        --r-lg: 24px;
        --r-xl: 32px;
        --display: "Figtree", sans-serif;
        --mono: "DM Mono", monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        background: var(--bg);
        color: var(--text);
        font-family: var(--display);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      /* ── MESH BG ── */
      .mesh {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background:
          radial-gradient(
            ellipse 70% 55% at 10% 5%,
            rgba(255, 0, 204, 0.13) 0%,
            transparent 60%
          ),
          radial-gradient(
            ellipse 50% 40% at 90% 15%,
            rgba(153, 85, 255, 0.1) 0%,
            transparent 55%
          ),
          radial-gradient(
            ellipse 60% 45% at 80% 85%,
            rgba(0, 170, 255, 0.08) 0%,
            transparent 55%
          ),
          radial-gradient(
            ellipse 40% 35% at 20% 90%,
            rgba(0, 255, 136, 0.07) 0%,
            transparent 50%
          );
      }

      /* grain */
      .grain {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        opacity: 0.35;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
      }

      /* ── LAYOUT ── */
      .page {
        position: relative;
        z-index: 1;
        max-width: 680px;
        margin: 0 auto;
        padding: 3rem 1.25rem 5rem;
      }

      /* ── SECTION ── */
      .section {
        margin-bottom: 1.75rem;
      }

      .section-label {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--mono);
        font-size: 0.65rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-bottom: 0.85rem;
        padding: 0 0.25rem;
      }

      .section-label::before {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      .section-label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      /* ── LINK GRID ── */
      .link-grid {
        display: grid;
        gap: 10px;
        grid-template-columns: 1fr 1fr;
      }

      .link-grid.cols-1 {
        grid-template-columns: 1fr;
      }

      /* ── LINK CARD ── */
      .lc {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.1rem;
        border-radius: var(--r-lg);
        background: var(--glass);
        border: 1px solid var(--border);
        backdrop-filter: blur(24px) saturate(160%);
        -webkit-backdrop-filter: blur(24px) saturate(160%);
        text-decoration: none;
        color: var(--text);
        position: relative;
        overflow: hidden;
        transition:
          background 0.22s,
          border-color 0.22s,
          transform 0.18s;
        cursor: pointer;
      }

      .lc::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.03) 0%,
          transparent 60%
        );
        pointer-events: none;
      }

      .lc::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.25),
          transparent
        );
        opacity: 0;
        transition: opacity 0.22s;
      }

      .lc:hover {
        background: var(--glass-h);
        border-color: var(--border-h);
        transform: translateY(-2px);
      }

      .lc:hover::after {
        opacity: 1;
      }

      .lc:active {
        transform: scale(0.98);
      }

      /* ── SOON CARD (desfocado/desbotado) ── */
      .lc.lc-soon {
        opacity: 0.42;
        filter: blur(1.2px) grayscale(40%);
        cursor: default;
        pointer-events: none;
        transform: none !important;
      }

      .lc.lc-soon::after {
        display: none;
      }

      /* ── ICON BOX ── */
      .lc-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.25rem;
        position: relative;
      }

      .lc-icon.pink {
        background: var(--pink-dim);
        border: 1px solid rgba(255, 0, 204, 0.22);
      }

      .lc-icon.neon {
        background: var(--neon-dim);
        border: 1px solid var(--neon-glow);
      }

      .lc-icon.acqua {
        background: var(--acqua-dim);
        border: 1px solid rgba(0, 255, 170, 0.22);
        color: var(--acqua);
      }

      .lc-icon.amber {
        background: var(--amber-dim);
        border: 1px solid rgba(255, 170, 0, 0.22);
      }

      .lc-icon.blue {
        background: var(--blue-dim);
        border: 1px solid rgba(0, 170, 200, 0.22);
      }

      .lc-icon.purple {
        background: var(--purple-dim);
        border: 1px solid rgba(153, 85, 255, 0.22);
      }

      .lc-icon.gray {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border);
      }

      /* ── TEXT ── */
      .lc-body {
        flex: 1;
        min-width: 0;
      }

      .lc-title {
        font-weight: 700;
        font-size: 0.92rem;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2;
      }

      .lc-sub {
        font-family: var(--mono);
        font-size: 0.65rem;
        color: var(--text-3);
        letter-spacing: 0.06em;
        margin-top: 0.2rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* ── BADGES ── */
      .lc-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 0.35rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.18rem 0.55rem;
        border-radius: 999px;
        font-family: var(--mono);
        font-size: 0.58rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .badge.pink {
        background: var(--pink-dim);
        border: 1px solid rgba(255, 0, 204, 0.25);
        color: var(--pink-s);
      }

      .badge.neon {
        background: var(--neon-dim);
        border: 1px solid var(--neon-glow);
        color: var(--neon);
      }

      .badge.acqua {
        background: var(--acqua-dim);
        border: 1px solid rgba(0, 255, 170, 0.3);
        color: var(--acqua);
      }

      .badge.amber {
        background: var(--amber-dim);
        border: 1px solid rgba(255, 170, 0, 0.25);
        color: var(--amber);
      }

      .badge.blue {
        background: var(--blue-dim);
        border: 1px solid rgba(0, 170, 200, 0.25);
        color: var(--blue);
      }

      .badge.purple {
        background: var(--purple-dim);
        border: 1px solid rgba(153, 85, 255, 0.25);
        color: var(--purple);
      }

      .badge.gray {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border);
        color: var(--text-3);
      }

      .badge.live::before {
        content: "";
        width: 5px;
        height: 5px;
        background: currentColor;
        border-radius: 50%;
        animation: blink 2s ease infinite;
      }

      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.25; }
      }

      /* ── FOOTER ── */
      .hub-footer {
        text-align: center;
        margin-top: 3.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
      }

      .hub-footer-brand {
        font-weight: 900;
        font-size: 0.9rem;
        letter-spacing: -0.02em;
        color: var(--text-3);
      }

      .hub-footer-brand .neo {
        color: var(--pink);
        opacity: 0.7;
      }

      .hub-footer-sub {
        font-family: var(--mono);
        font-size: 0.62rem;
        color: var(--text-3);
        letter-spacing: 0.08em;
        margin-top: 0.3rem;
      }

      /* ── ANIMATIONS ── */
      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .section:nth-child(1) { animation: fadeUp 0.5s ease both 0.35s; }
      .section:nth-child(2) { animation: fadeUp 0.5s ease both 0.45s; }
      .section:nth-child(3) { animation: fadeUp 0.5s ease both 0.55s; }
      .section:nth-child(4) { animation: fadeUp 0.5s ease both 0.65s; }
      .hub-footer { animation: fadeUp 0.5s ease both 0.75s; }

      /* ── RESPONSIVE ── */
      @media (max-width: 480px) {
        .page { padding: 2rem 1rem; }
        .link-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="mesh"></div>
    <div class="grain"></div>

    <div class="page">
      <HubHeader />

      {sections.map((section) => (
        <section class="section">
          <div class="section-label">{section.label}</div>
          <div class:list={["link-grid", section.cols === 1 && "cols-1"]}>
            {section.links.map((link) => (
              <LinkCard
                href={link.href}
                title={link.title}
                sub={link.sub}
                icon={link.icon}
                color={link.color}
                badges={link.badges}
              />
            ))}
          </div>
        </section>
      ))}

      <footer class="hub-footer">
        <div class="hub-footer-brand">
          <span class="neo">NEØ</span> FlowOFF Agency
        </div>
        <div class="hub-footer-sub">
          On Chain · Base Mainnet · neoflowoff.eth.limo
        </div>
      </footer>
    </div>

    <script>
      document.querySelectorAll<HTMLElement>(".lc").forEach((el) => {
        el.addEventListener("pointerdown", (e: PointerEvent) => {
          const target = e.currentTarget as HTMLElement;
          const r = document.createElement("span");
          const rect = target.getBoundingClientRect();
          const size = Math.max(rect.width, rect.height) * 2;
          r.style.cssText = `
            position:absolute;width:${size}px;height:${size}px;
            left:${e.clientX - rect.left - size / 2}px;top:${e.clientY - rect.top - size / 2}px;
            border-radius:50%;background:rgba(255,255,255,0.05);
            transform:scale(0);animation:ripple 0.5s ease forwards;pointer-events:none;
          `;
          target.appendChild(r);
          setTimeout(() => r.remove(), 600);
        });
      });
    </script>

    <style>
      @keyframes ripple {
        to { transform: scale(1); opacity: 0; }
      }
    </style>
  </body>
</html>
