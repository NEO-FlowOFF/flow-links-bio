    <!-- Robots -->
    <meta name="robots" content="index, follow" />

    <!-- Theme / PWA -->
    <meta name="theme-color" content="#FF00CC" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="NEØ Hub" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />


    <!-- Open Graph / SEO -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="NEØ FlowOFF Agency" />
    <meta property="og:title" content="NEØ FlowOFF — O Hub da Nova Economia" />
    <meta property="og:description" content="Acelere seus projetos com nossa infraestrutura Web3 + AI. Tudo em um lugar na Base Mainnet." />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:url" content="https://flow-links-bio.pages.dev/hub" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@neoflowoff" />
    <meta name="twitter:creator" content="@neoflowoff" />
    <meta name="twitter:title" content="NEØ FlowOFF — Agency Hub" />
    <meta name="twitter:description" content="Infraestrutura Web3 + IA para todos. Pagamentos e ferramentas On-Chain." />
    <meta name="twitter:image" content="/og-image.png" />


    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;0,900;1,900&family=DM+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --bg: #06060a;
        --surface: #0c0c12;
        --glass: rgba(255, 255, 255, 0.052);
        --glass-h: rgba(255, 255, 255, 0.09);
        --glass-str: rgba(255, 255, 255, 0.12);
        --border: rgba(255, 255, 255, 0.08);
        --border-h: rgba(255, 255, 255, 0.18);
        --pink: #ff00cc;
        --pink-s: #ff40d9;
        --pink-dim: rgba(255, 0, 204, 0.16);
        --pink-glow: rgba(255, 0, 204, 0.28);
        --green: #00ff88;
        --green-dim: rgba(0, 255, 136, 0.14);
        --amber: #ffaa00;
        --amber-dim: rgba(255, 170, 0, 0.14);
        --blue: #00aaff;
        --blue-dim: rgba(0, 170, 255, 0.14);
        --purple: #9955ff;
        --purple-dim: rgba(153, 85, 255, 0.14);
        --text: rgba(255, 255, 255, 0.9);
        --text-2: rgba(255, 255, 255, 0.52);
        --text-3: rgba(255, 255, 255, 0.28);
        --r-sm: 12px;
        --r-md: 18px;
        --r-lg: 24px;
        --r-xl: 32px;
        --display: "Figtree", sans-serif;
        --mono: "DM Mono", monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        background: var(--bg);
        color: var(--text);
        font-family: var(--display);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      /* ── MESH BG ── */
      .mesh {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background:
          radial-gradient(
            ellipse 70% 55% at 10% 5%,
            rgba(255, 0, 204, 0.13) 0%,
            transparent 60%
          ),
          radial-gradient(
            ellipse 50% 40% at 90% 15%,
            rgba(153, 85, 255, 0.1) 0%,
            transparent 55%
          ),
          radial-gradient(
            ellipse 60% 45% at 80% 85%,
            rgba(0, 170, 255, 0.08) 0%,
            transparent 55%
          ),
          radial-gradient(
            ellipse 40% 35% at 20% 90%,
            rgba(0, 255, 136, 0.07) 0%,
            transparent 50%
          );
      }

      /* grain */
      .grain {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        opacity: 0.35;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
      }

      /* ── LAYOUT ── */
      .page {
        position: relative;
        z-index: 1;
        max-width: 680px;
        margin: 0 auto;
        padding: 3rem 1.25rem 5rem;
      }

      /* ── HEADER ── */
      .hub-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 3rem;
        gap: 0;
      }

      /* avatar ring */
      .avatar-wrap {
        position: relative;
        width: 88px;
        height: 88px;
        margin-bottom: 1.25rem;
        animation: fadeUp 0.5s ease both 0.05s;
      }

      .avatar-ring {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        background: conic-gradient(
          var(--pink) 0deg,
          var(--purple) 90deg,
          var(--blue) 180deg,
          var(--green) 270deg,
          var(--pink) 360deg
        );
        animation: spin 8s linear infinite;
        opacity: 0.7;
      }

      .avatar-ring-mask {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        background: conic-gradient(
          var(--pink) 0deg,
          var(--purple) 90deg,
          var(--blue) 180deg,
          var(--green) 270deg,
          var(--pink) 360deg
        );
        mask: radial-gradient(
          farthest-side,
          transparent calc(100% - 3px),
          #000 calc(100% - 3px)
        );
        -webkit-mask: radial-gradient(
          farthest-side,
          transparent calc(100% - 3px),
          #000 calc(100% - 3px)
        );
        animation: spin 8s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      .avatar-inner {
        position: relative;
        z-index: 1;
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: linear-gradient(
          135deg,
          rgba(255, 0, 204, 0.25),
          rgba(153, 85, 255, 0.2)
        );
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--display);
        font-weight: 900;
        font-size: 1.5rem;
        letter-spacing: -0.05em;
        color: #fff;
      }

      .hub-name {
        font-family: var(--display);
        font-weight: 900;
        font-size: 1.75rem;
        letter-spacing: -0.04em;
        color: #fff;
        animation: fadeUp 0.5s ease both 0.15s;
      }

      .hub-name .neo {
        color: var(--pink);
      }

      .hub-tagline {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-top: 0.4rem;
        animation: fadeUp 0.5s ease both 0.25s;
      }

      .hub-desc {
        font-size: 0.88rem;
        color: var(--text-2);
        line-height: 1.7;
        max-width: 380px;
        margin-top: 0.85rem;
        animation: fadeUp 0.5s ease both 0.32s;
      }

      /* ── SECTION ── */
      .section {
        margin-bottom: 1.75rem;
      }

      .section-label {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--mono);
        font-size: 0.65rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-bottom: 0.85rem;
        padding: 0 0.25rem;
      }

      .section-label::before {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      .section-label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      /* ── LINK GRID ── */
      .link-grid {
        display: grid;
        gap: 10px;
      }

      .link-grid.cols-2 {
        grid-template-columns: 1fr 1fr;
      }
      .link-grid.cols-1 {
        grid-template-columns: 1fr;
      }

      /* ── LINK CARD ── */
      .lc {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.1rem;
        border-radius: var(--r-lg);
        background: var(--glass);
        border: 1px solid var(--border);
        backdrop-filter: blur(24px) saturate(160%);
        -webkit-backdrop-filter: blur(24px) saturate(160%);
        text-decoration: none;
        color: var(--text);
        position: relative;
        overflow: hidden;
        transition:
          background 0.22s,
          border-color 0.22s,
          transform 0.18s;
        cursor: pointer;
      }

      .lc::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.03) 0%,
          transparent 60%
        );
        pointer-events: none;
      }

      /* top shine on hover */
      .lc::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.25),
          transparent
        );
        opacity: 0;
        transition: opacity 0.22s;
      }

      .lc:hover {
        background: var(--glass-h);
        border-color: var(--border-h);
        transform: translateY(-2px);
      }
      .lc:hover::after {
        opacity: 1;
      }
      .lc:active {
        transform: scale(0.98);
      }

      /* FEATURED: wider/taller card */
      .lc.featured {
        padding: 1.35rem 1.25rem;
      }

      /* ── ICON BOX ── */
      .lc-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.25rem;
        position: relative;
      }

      .lc-icon.pink {
        background: var(--pink-dim);
        border: 1px solid rgba(255, 0, 204, 0.22);
      }
      .lc-icon.green {
        background: var(--green-dim);
        border: 1px solid rgba(0, 255, 136, 0.22);
      }
      .lc-icon.amber {
        background: var(--amber-dim);
        border: 1px solid rgba(255, 170, 0, 0.22);
      }
      .lc-icon.blue {
        background: var(--blue-dim);
        border: 1px solid rgba(0, 170, 255, 0.22);
      }
      .lc-icon.purple {
        background: var(--purple-dim);
        border: 1px solid rgba(153, 85, 255, 0.22);
      }
      .lc-icon.mono {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border);
      }

      /* ── TEXT ── */
      .lc-body {
        flex: 1;
        min-width: 0;
      }

      .lc-title {
        font-weight: 700;
        font-size: 0.92rem;
        color: #fff;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2;
      }

      .lc-sub {
        font-family: var(--mono);
        font-size: 0.65rem;
        color: var(--text-3);
        letter-spacing: 0.06em;
        margin-top: 0.2rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* ── BADGES ── */
      .lc-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 0.35rem;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.18rem 0.55rem;
        border-radius: 999px;
        font-family: var(--mono);
        font-size: 0.58rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .badge.pink {
        background: var(--pink-dim);
        border: 1px solid rgba(255, 0, 204, 0.25);
        color: var(--pink-s);
      }
      .badge.green {
        background: var(--green-dim);
        border: 1px solid rgba(0, 255, 136, 0.25);
        color: var(--green);
      }
      .badge.amber {
        background: var(--amber-dim);
        border: 1px solid rgba(255, 170, 0, 0.25);
        color: var(--amber);
      }
      .badge.blue {
        background: var(--blue-dim);
        border: 1px solid rgba(0, 170, 255, 0.25);
        color: var(--blue);
      }
      .badge.purple {
        background: var(--purple-dim);
        border: 1px solid rgba(153, 85, 255, 0.25);
        color: var(--purple);
      }
      .badge.mono {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border);
        color: var(--text-3);
      }

      /* pulsing dot for "live" / "soon" */
      .badge.live::before {
        content: "";
        width: 5px;
        height: 5px;
        background: currentColor;
        border-radius: 50%;
        animation: blink 2s ease infinite;
      }

      @keyframes blink {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.25;
        }
      }

      /* ── ARROW ── */
      .lc-arrow {
        color: var(--text-3);
        font-size: 0.85rem;
        flex-shrink: 0;
        transition:
          color 0.2s,
          transform 0.2s;
      }

      .lc:hover .lc-arrow {
        color: var(--pink-s);
        transform: translate(2px, -2px);
      }

      /* FEATURED HERO card — full width, more visual weight */
      .lc-hero {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.85rem;
        padding: 1.5rem;
      }

      .lc-hero .lc-icon {
        width: 52px;
        height: 52px;
        border-radius: 18px;
        font-size: 1.5rem;
      }

      .lc-hero .lc-title {
        font-size: 1.1rem;
      }
      .lc-hero .lc-sub {
        font-size: 0.72rem;
      }

      .lc-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
      }

      .lc-hero-arrow {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--pink-dim);
        border: 1px solid rgba(255, 0, 204, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--pink-s);
        font-size: 0.9rem;
        flex-shrink: 0;
        transition:
          background 0.2s,
          transform 0.2s;
      }

      .lc:hover .lc-hero-arrow {
        background: var(--pink);
        color: #fff;
        transform: translate(2px, -2px);
      }

      /* ── FOOTER ── */
      .hub-footer {
        text-align: center;
        margin-top: 3.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
      }

      .hub-footer-brand {
        font-weight: 900;
        font-size: 0.9rem;
        letter-spacing: -0.02em;
        color: var(--text-3);
      }

      .hub-footer-brand .neo {
        color: var(--pink);
        opacity: 0.7;
      }

      .hub-footer-sub {
        font-family: var(--mono);
        font-size: 0.62rem;
        color: var(--text-3);
        letter-spacing: 0.08em;
        margin-top: 0.3rem;
      }

      /* ── ANIMATIONS ── */
      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* stagger sections */
      .section:nth-child(1) {
        animation: fadeUp 0.5s ease both 0.35s;
      }
      .section:nth-child(2) {
        animation: fadeUp 0.5s ease both 0.45s;
      }
      .section:nth-child(3) {
        animation: fadeUp 0.5s ease both 0.55s;
      }
      .section:nth-child(4) {
        animation: fadeUp 0.5s ease both 0.65s;
      }
      .hub-footer {
        animation: fadeUp 0.5s ease both 0.75s;
      }

      /* ── RESPONSIVE ── */
      @media (max-width: 480px) {
        .link-grid.cols-2 {
          grid-template-columns: 1fr;
        }
        .page {
          padding: 2rem 1rem 4rem;
        }
        .hub-name {
          font-size: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="mesh"></div>
    <div class="grain"></div>

    <div class="page">
      <!-- HEADER -->
      <header class="hub-header">
        <div class="avatar-wrap">
          <div class="avatar-ring-mask"></div>
          <div class="avatar-inner">
            <img src="/flowoff_logo.webp" alt="NEØ FlowOFF Logo" style="width: 75%; height: 75%; object-fit: contain;" />
          </div>

        </div>
        <h1 class="hub-name"><span class="neo">NEØ</span> FlowOFF</h1>
        <p class="hub-tagline">Agency Hub · On Chain · Base Mainnet</p>
        <p class="hub-desc">
          Infraestrutura Web3 + AI para todos. Pagamentos, tokens, ferramentas e
          projetos — tudo em um lugar.
        </p>
      </header>

      <!-- ── SEÇÃO 1: PRINCIPAL ── -->
      <section class="section">
        <div class="section-label">Principal</div>

        <div class="link-grid cols-1" style="margin-bottom: 10px">
          <!-- TOKEN — hero card -->
          <a
            href="https://neoflw.vercel.app/"
            target="_blank"
            rel="noopener"
            class="lc lc-hero"
          >
            <div class="lc-hero-row">
              <div style="display: flex; align-items: center; gap: 0.9rem">
                <div
                  class="lc-icon pink"
                  style="
                    width: 52px;
                    height: 52px;
                    border-radius: 18px;
                    font-size: 1.4rem;
                  "
                >
                  ⬡
                </div>
                <div>
                  <div class="lc-title" style="font-size: 1.1rem">
                    $NEOFLW Token
                  </div>
                  <div class="lc-sub">neoflw.vercel.app</div>
                  <div class="lc-badges" style="margin-top: 0.4rem">
                    <span class="badge green live">Live · Base Mainnet</span>
                    <span class="badge pink">ERC-20</span>
                  </div>
                </div>
              </div>
              <div class="lc-hero-arrow">↗</div>
            </div>
          </a>
        </div>

        <div class="link-grid cols-2">
          <!-- FAÇA SEU SITE -->
          <a
            href="https://lp.neoflowoff.agency/"
            target="_blank"
            rel="noopener"
            class="lc featured"
          >
            <div class="lc-icon blue">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              >
                <rect x="3" y="3" width="18" height="18" rx="3"></rect>
                <path d="M3 9h18M9 21V9"></path>
              </svg>
            </div>
            <div class="lc-body">
              <div class="lc-title">Faça seu Site</div>
              <div class="lc-sub">lp.neoflowoff.agency</div>
              <div class="lc-badges">
                <span class="badge blue">Agency</span>
              </div>
            </div>
            <div class="lc-arrow">↗</div>
          </a>

          <!-- FLOWPAY -->
          <a
            href="https://flowpay.cash/"
            target="_blank"
            rel="noopener"
            class="lc featured"
          >
            <div class="lc-icon green">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              >
                <path
                  d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"
                ></path>
                <path
                  d="M15 8.5c-.83-.5-1.87-.5-2.5-.5C10.57 8 9 9.12 9 10.5c0 1.5 1.5 2 3 2.5s3 1 3 2.5c0 1.38-1.57 2.5-3.5 2.5-.63 0-1.67-.12-2.5-.5"
                ></path>
                <path d="M12 6v2M12 16v2"></path>
              </svg>
            </div>
            <div class="lc-body">
              <div class="lc-title">Link de Pagamentos</div>
              <div class="lc-sub">flowpay.cash</div>
              <div class="lc-badges">
                <span class="badge green">💸 Economize nas taxas</span>
              </div>
            </div>
            <div class="lc-arrow">↗</div>
          </a>
        </div>

        <!-- THE ARCHITECT -->
        <div class="link-grid cols-1" style="margin-top: 10px">
          <a
            href="https://neomello.eth.limo/"
            target="_blank"
            rel="noopener"
            class="lc featured"
          >
            <div
              class="lc-icon"
              style="
                background: linear-gradient(
                  135deg,
                  rgba(255, 0, 204, 0.18),
                  rgba(153, 85, 255, 0.18)
                );
                border: 1px solid rgba(153, 85, 255, 0.28);
                width: 44px;
                height: 44px;
                border-radius: 14px;
              "
            >
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="url(#grad1)"
                stroke-width="1.8"
                stroke-linecap="round"
              >
