---
import Base from "../layouts/Base.astro";
import HubHeader from "../components/HubHeader.astro";
import HubSection from "../components/HubSection.astro";
import LinkCard from "../components/LinkCard.astro";
import { sections } from "../data/links";
---

<Base>
  <div class="page">
    <HubHeader />

    {
      sections.map((section) => (
        <section class:list={["section", { "section-soon": section.soon }]}>
          <div class="section-label">{section.label}</div>
          <div class="link-grid">
            {section.links.map((link) => (
              <LinkCard {...link} />
            ))}
          </div>
        </section>
      ))
    }

    <div class="sc-player">
      <iframe
        id="sc-widget"
        width="100%"
        height="20"
        scrolling="no"
        frameborder="no"
        allow="autoplay"
        src="https://w.soundcloud.com/player/?url=https%3A//soundcloud.com/modestep/bodybag&auto_play=true&show_artwork=false&show_playcount=false&show_user=false&buying=false&sharing=false&download=false&color=%23c8d41a&visual=false"
      ></iframe>
    </div>

    <footer class="hub-footer">
      <div class="hub-footer-brand">
        <span class="neo">NEØ</span> FlowOFF Agency
      </div>
      <div class="hub-footer-sub">
        On Chain · Base Mainnet · neoflowoff.eth.limo
      </div>
    </footer>
  </div>
</Base>

<script>
  /* "EM BREVE" toast on soon section tap */
  document.querySelectorAll<HTMLElement>(".section-soon").forEach((el) => {
    el.addEventListener("click", (e: MouseEvent) => {
      const existing = document.querySelector(".soon-toast");
      if (existing) existing.remove();
      const toast = document.createElement("div");
      toast.className = "soon-toast";
      toast.style.left = `${e.clientX}px`;
      toast.style.top = `${e.clientY}px`;
      toast.textContent = "EM BREVE";
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 1300);
    });
  });

  /* ripple on tap for mobile feel */
  document.querySelectorAll<HTMLElement>(".lc").forEach((el) => {
    el.addEventListener("pointerdown", (e: PointerEvent) => {
      const target = e.currentTarget as HTMLElement;
      const r = document.createElement("span");
      const rect = target.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height) * 2;
      r.style.cssText = `
        position:absolute;width:${size}px;height:${size}px;
        left:${e.clientX - rect.left - size / 2}px;top:${e.clientY - rect.top - size / 2}px;
        border-radius:50%;background:rgba(255,255,255,0.05);
        transform:scale(0);animation:ripple 0.5s ease forwards;pointer-events:none;
      `;
      target.appendChild(r);
      setTimeout(() => r.remove(), 600);
    });
  });
</script>
