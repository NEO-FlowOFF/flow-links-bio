---
import { Image } from "astro:assets";
import logo from "../../public/flowoff_logo.webp";

interface Props {
  description?: string;
}

const { description = "neo@neoflowoff.agency" } = Astro.props;
---

<header class="hub-header">
  <div class="avatar-container">
    <div class="avatar-wrap">
      <div class="avatar-ring"></div>
      <div class="avatar-inner">
        <Image
          src={logo}
          alt="NEØ FlowOFF Logo"
          width={43}
          height={43}
          loading="eager"
          style="object-fit: contain;"
        />
      </div>
    </div>
  </div>

  <h1 class="hub-name">
    <span class="flow">neoflowoff.agency</span>
  </h1>

  <div class="badge-row">
    <span class="header-badge">Agency</span>
    <span class="dot"></span>
    <span class="header-badge accent">Code is law.</span>
    <span class="dot"></span>
    <span class="header-badge">Multiagents</span>
  </div>

  <p class="hub-desc">{description}</p>
</header>

<style>
  .hub-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 2.5rem;
    position: relative;
  }

  /* ── AVATAR ── */
  .avatar-container {
    position: relative;
    margin-bottom: 1.2rem;
  }

  .avatar-wrap {
    position: relative;
    width: 72px;
    height: 72px;
  }

  .avatar-ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(
      rgba(255, 255, 255, 0.08) 0deg,
      rgba(255, 255, 255, 0.02) 120deg,
      rgba(200, 212, 26, 0.1) 240deg,
      rgba(255, 255, 255, 0.08) 360deg
    );
    mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 1.5px),
      #000 calc(100% - 1.5px)
    );
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 1.5px),
      #000 calc(100% - 1.5px)
    );
    animation: spin 12s linear infinite;
  }

  .avatar-inner {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--card);
    border: 1px solid rgba(255, 255, 255, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.02);
  }

  /* ── NAME ── */
  .hub-name {
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
  }

  .hub-name .neo {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
  }

  .hub-name .flow {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 300;
  }

  /* ── BADGE ROW ── */
  .badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 0.8rem;
  }

  .header-badge {
    font-family: var(--mono);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-3);
  }

  .header-badge.accent {
    color: var(--neon);
    opacity: 0.5;
  }

  .dot {
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
  }

  /* ── DESC ── */
  .hub-desc {
    font-family: var(--mono);
    font-size: 0.65rem;
    color: var(--pink);
    letter-spacing: 0.08em;
    opacity: 1;
  }

  @media (max-width: 480px) {
    .hub-name {
      font-size: 1.6rem;
    }
  }
</style>
