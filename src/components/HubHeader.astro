---
interface Props {
  description?: string;
}

const {
  description = "Infraestrutura Web3 + AI para o Brasil. Pagamentos, tokens, ferramentas e projetos — tudo em um lugar.",
} = Astro.props;
---

<header class="hub-header">
  <div class="avatar-container">
    <div class="avatar-glow"></div>
    <div class="avatar-wrap">
      <div class="avatar-ring-mask"></div>
      <div class="avatar-inner">
        <img
          src="/flowoff_logo.webp"
          alt="NEØ FlowOFF Logo"
          style="width: 75%; height: 75%; object-fit: contain;"
        />
      </div>

    </div>
  </div>

  <div class="header-content">
    <h1 class="hub-name">
      <span class="neo">NEØ</span>
      <span class="flow">FlowOFF</span>
    </h1>
    
    <div class="badge-row">
      <span class="header-badge">Agency Hub</span>
      <span class="dot"></span>
      <span class="header-badge acqua">On Chain</span>
      <span class="dot"></span>
      <span class="header-badge">Base Mainnet</span>
    </div>

    <p class="hub-desc">
      {description}
    </p>
  </div>
</header>

<style>
  .hub-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 4rem;
    position: relative;
  }

  /* AVATAR SYSTEM */
  .avatar-container {
    position: relative;
    margin-bottom: 2rem;
    perspective: 1000px;
  }

  .avatar-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, var(--pink-glow) 0%, transparent 70%);
    opacity: 0.6;
    filter: blur(20px);
    animation: pulseGlow 4s ease-in-out infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 0.4; }
    50% { transform: scale(1.1); opacity: 0.7; }
  }

  .avatar-wrap {
    position: relative;
    width: 100px;
    height: 100px;
    z-index: 2;
    transform-style: preserve-3d;
    transition: transform 0.5s ease;
  }
  
  .avatar-container:hover .avatar-wrap {
    transform: rotateY(10deg) rotateX(5deg);
  }

  .avatar-ring-mask {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: conic-gradient(
      var(--pink) 0deg, 
      var(--acqua) 120deg, 
      var(--neon) 240deg, 
      var(--pink) 360deg
    );
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 3px));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 3px));
    animation: spin 8s linear infinite;
  }

  .avatar-inner {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, #111, #000);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 20px rgba(255, 0, 204, 0.1);
    overflow: hidden;
  }

  .logo-symbol {
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--pink);
    text-shadow: 0 0 15px var(--pink-glow);
    filter: drop-shadow(0 0 5px var(--pink));
  }

  /* TEXT SYSTEM */
  .hub-name {
    font-size: 2.5rem;
    font-weight: 950;
    letter-spacing: -0.06em;
    line-height: 1;
    margin-bottom: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .hub-name .neo {
    color: var(--pink);
    filter: drop-shadow(0 0 10px var(--pink-glow));
  }
  
  .hub-name .flow {
    color: #fff;
    background: linear-gradient(to bottom, #fff 40%, rgba(255,255,255,0.7));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* BADGE ROW */
  .badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .header-badge {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-3);
  }

  .header-badge.acqua {
    color: var(--acqua);
    text-shadow: 0 0 8px var(--acqua-glow);
  }

  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--border);
  }

  .hub-desc {
    font-size: 0.95rem;
    color: var(--text-2);
    line-height: 1.6;
    max-width: 420px;
    margin: 0 auto;
  }

  @media (max-width: 480px) {
    .hub-name { font-size: 2.1rem; }
  }
</style>
