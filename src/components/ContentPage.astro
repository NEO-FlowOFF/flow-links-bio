---
import Base from "../layouts/Base.astro";
import SiteNav from "./SiteNav.astro";

interface Section {
  title: string;
  body: string;
}

interface Link {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  sections: Section[];
  links?: Link[];
}

const {
  title,
  description,
  eyebrow,
  heading,
  intro,
  sections,
  links = [],
} = Astro.props;
---

<Base title={title} description={description}>
  <main class="content-page">
    <SiteNav />

    <article>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="intro">{intro}</p>

      <div class="content-grid">
        {sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </section>
        ))}
      </div>

      {links.length > 0 && (
        <div class="actions" aria-label="Próximos passos">
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      )}
    </article>
  </main>
</Base>

<style>
  .content-page {
    position: relative;
    z-index: 1;
    width: min(860px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  article {
    padding: clamp(1.4rem, 4vw, 3rem);
    border: 1px solid var(--border);
    border-radius: 24px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.025), transparent 45%), var(--card);
  }

  .eyebrow {
    margin-bottom: 0.75rem;
    color: var(--pink);
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 720px;
    font-size: clamp(2rem, 7vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .intro {
    max-width: 680px;
    margin-top: 1.25rem;
    color: var(--text-2);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.7;
  }

  .content-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 2rem;
  }

  section {
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: rgba(0, 0, 0, 0.12);
  }

  h2 {
    margin-bottom: 0.55rem;
    font-size: 1rem;
    font-weight: 600;
  }

  section p {
    color: var(--text-2);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .actions a {
    padding: 0.75rem 1rem;
    border-radius: 12px;
    background: var(--pink);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .actions a + a {
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
  }

  @media (max-width: 640px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
