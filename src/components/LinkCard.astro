---
import BadgeChip from "./BadgeChip.astro";
import type { Badge, BadgeColor } from "../data/links";

interface Props {
  href: string;
  title: string;
  sub: string;
  icon: string;
  color: BadgeColor;
  badges?: Badge[];
}

const { href, title, sub, icon, color, badges = [] } = Astro.props;
const isSoon = !href || href === "#";
const Tag = isSoon ? "div" : "a";
---

<Tag
  {...(isSoon ? {} : { href, target: "_blank", rel: "noopener" })}
  class:list={["lc", { "lc-soon": isSoon }]}
>
  <div class:list={["lc-icon", color]}>
    <Fragment set:html={icon} />
  </div>

  <div class="lc-body">
    <div class="lc-title">{title}</div>
    <div class="lc-sub">{sub}</div>

    {badges.length > 0 && (
      <div class="lc-badges">
        {badges.map((b) => (
          <BadgeChip label={b.label} color={b.color} pulse={b.pulse} />
        ))}
      </div>
    )}
  </div>
</Tag>
